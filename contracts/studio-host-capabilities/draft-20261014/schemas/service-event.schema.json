{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zicode.com/contracts/studio-host/service.v1/event-draft-2026-10-14.schema.json",
  "title": "Studio Host service.v1 task event draft",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "queued",
            "running"
          ]
        },
        "progress": {
          "type": "object",
          "properties": {
            "stage": {
              "enum": [
                "model_list",
                "model_generate",
                "mcp_discovery",
                "mcp_call"
              ]
            },
            "completedCalls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "stage"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "taskId",
        "sequence",
        "state",
        "progress"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "const": "completed"
        },
        "operation": {
          "const": "model.generate"
        },
        "result": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 262144
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "text",
            "inputTokens",
            "outputTokens",
            "truncated"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "taskId",
        "sequence",
        "state",
        "operation",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "const": "completed"
        },
        "operation": {
          "const": "mcp.tool.call"
        },
        "result": {
          "type": "object",
          "properties": {
            "isError": {
              "type": "boolean"
            },
            "content": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "text"
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 32768
                      }
                    },
                    "required": [
                      "type",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "structured"
                      },
                      "value": {
                        "type": "object",
                        "maxProperties": 128
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "isError",
            "content"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "taskId",
        "sequence",
        "state",
        "operation",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "failed",
            "cancelled",
            "timed_out",
            "revoked"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "MODEL_UNAVAILABLE",
                "MCP_UNAVAILABLE",
                "CONSENT_REQUIRED",
                "PERMISSION_REVOKED",
                "OUTPUT_TOO_LARGE",
                "DEADLINE_EXCEEDED",
                "INVALID_RESULT",
                "HOST_FAILURE"
              ]
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "taskId",
        "sequence",
        "state",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
