{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devtools.zicode.com/plugins/spring-actuator/0.1.1/task-api-proposal/submit.schema.json",
  "title": "plugin.task.lifecycle.v1 submit request proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "idempotencyKey", "operationId", "input"],
  "properties": {
    "schemaVersion": {"const": 1},
    "idempotencyKey": {"type": "string", "format": "uuid"},
    "operationId": {"const": "devtools.spring-actuator.run.v1"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "endpoints"],
      "properties": {
        "origin": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https?://[^/?#@]+$", "description": "Canonical origin only: no userinfo, path, query, fragment, or credentials."},
        "endpoints": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["health", "info", "metrics"]}}
      }
    }
  }
}
