{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devtools.zicode.com/plugins/spring-actuator/0.1.1/task-api-proposal/confirm.response.schema.json",
  "title": "plugin.task.lifecycle.v1 step decision response proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskRef", "operationStepId", "decision", "taskState", "latestSequence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskRef": {"type": "string", "minLength": 1, "maxLength": 256},
    "operationStepId": {"enum": ["actuator.health", "actuator.info", "actuator.metrics"]},
    "decision": {"enum": ["approve", "decline"]},
    "taskState": {"enum": ["queued", "running", "awaiting_confirmation", "succeeded", "partial", "declined", "failed", "cancelled", "revoked", "interrupted"]},
    "latestSequence": {"type": "integer", "minimum": 1}
  }
}
