{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devtools.zicode.com/plugins/spring-actuator/0.1.1/task-api-proposal/confirm.request.schema.json",
  "title": "plugin.task.lifecycle.v1 trusted step decision proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskRef", "operationStepId", "confirmationId", "decision"],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskRef": {"type": "string", "minLength": 1, "maxLength": 256},
    "operationStepId": {"enum": ["actuator.health", "actuator.info", "actuator.metrics"]},
    "confirmationId": {"type": "string", "minLength": 1, "maxLength": 256},
    "decision": {"enum": ["approve", "decline"]}
  }
}
