{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devtools.zicode.com/plugins/spring-actuator/0.1.1/result-resource-proposal/report.schema.json",
  "title": "Spring Actuator portable summary report proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sourceToolId", "summary", "checks", "provenance"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "sourceToolId": {"const": "spring-actuator"},
    "summary": {"type": "object", "additionalProperties": false, "required": ["endpointCount"], "properties": {"endpointCount": {"type": "integer", "minimum": 1, "maximum": 3}, "healthStatus": {"enum": ["UP", "DOWN", "OUT_OF_SERVICE", "UNKNOWN"]}}},
    "checks": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["endpoint", "httpStatus", "responseBytes", "topLevelFieldCount"], "properties": {"endpoint": {"enum": ["health", "info", "metrics"]}, "httpStatus": {"type": "integer", "minimum": 200, "maximum": 599}, "responseBytes": {"type": "integer", "minimum": 0, "maximum": 1048576}, "topLevelFieldCount": {"type": "integer", "minimum": 0, "maximum": 20000}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["pluginId", "pluginVersion", "toolVersion", "applicationVersion", "runtimeFingerprint"], "properties": {"pluginId": {"const": "com.zicode.devtools.spring-actuator"}, "pluginVersion": {"const": "0.1.1"}, "toolVersion": {"const": "1.1.1"}, "applicationVersion": {"type": "string", "maxLength": 64}, "runtimeFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  },
  "allOf": [
    {"properties": {"checks": {"items": {"allOf": [
      {"if": {"properties": {"endpoint": {"enum": ["info", "metrics"]}}, "required": ["endpoint"]}, "then": {"properties": {"httpStatus": {"maximum": 299}}}},
      {"if": {"properties": {"endpoint": {"const": "health"}}, "required": ["endpoint"]}, "then": {"properties": {"httpStatus": {"anyOf": [{"maximum": 299}, {"const": 503}]}}}}
    ]}}}}
  ],
  "x-studio-host-generated": ["generatedAt", "sourceToolId", "provenance.pluginId", "provenance.pluginVersion", "provenance.toolVersion", "provenance.applicationVersion", "provenance.runtimeFingerprint"],
  "x-conformance": ["checks endpoint IDs are unique", "summary.endpointCount equals checks.length", "summary.healthStatus equals the unique health check status when present", "only successful HTTP 2xx or health HTTP 503 captures are reportable"]
}
