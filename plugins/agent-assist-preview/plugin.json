{
  "schemaVersion": 2,
  "id": "com.zicode.devtools.agent-assist",
  "name": "ZiDevTools Agent Assist Preview",
  "displayName": "ZiDevTools 模型辅助",
  "description": "在 Studio 中选择模型，对用户明确提供的目标与文本资料生成一轮可审阅回答。仅为模型辅助视图，不包含 MCP 调用或 Agent 自动执行。",
  "version": "0.1.3",
  "publisher": "zicode",
  "license": "MIT",
  "engines": {
    "zicode": ">=0.1.0 <1.0.0",
    "pluginApi": "^1.0.0"
  },
  "requiredProfiles": {
    "model.catalog.read.v1": "=1.0.0-preview.1",
    "model.generate.v1": "=1.0.0-preview.1",
    "application.directory.v1": "=1.0.0-preview.1",
    "view.operation.directory.v1": "=1.0.0-preview.1"
  },
  "activationEvents": [
    "onView:devtools.agent-assist.main"
  ],
  "contributes": {
    "activities": [
      {
        "id": "devtools.agent-assist",
        "title": "ZiDevTools 模型辅助",
        "order": 860,
        "directory": {
          "categoryId": "ai",
          "aliases": [
            "模型辅助",
            "AI问答",
            "Agent Assist",
            "model assistant"
          ],
          "description": "选择当前场景模型，对目标与文字资料进行一轮生成；发送前逐次确认，不自动调用工具。"
        }
      }
    ],
    "views": [
      {
        "id": "devtools.agent-assist.main",
        "activity": "devtools.agent-assist",
        "location": "main",
        "title": "模型辅助",
        "entry": "views/main.html"
      }
    ],
    "capabilities": [],
    "commands": [],
    "piTools": [],
    "viewOperations": [
      {
        "id": "devtools.agent-assist.models",
        "title": "读取模型目录",
        "viewId": "devtools.agent-assist.main",
        "sourceToolId": "agent-runner",
        "directory": {
          "categoryId": "ai",
          "aliases": [
            "模型列表",
            "list models"
          ],
          "description": "定位读取模型按钮；用户点击后才读取当前场景的模型目录。"
        }
      },
      {
        "id": "devtools.agent-assist.generate",
        "title": "预览并生成回答",
        "viewId": "devtools.agent-assist.main",
        "sourceToolId": "agent-runner",
        "directory": {
          "categoryId": "ai",
          "aliases": [
            "生成回答",
            "model generation"
          ],
          "description": "定位生成区域；目标、资料及模型选择保留，仍需用户点击并逐次确认。"
        }
      }
    ]
  },
  "permissions": {
    "required": [
      {
        "name": "model.catalog.read",
        "reason": "由用户点击后列出当前 Studio 场景已配置的模型名称与不透明引用。"
      },
      {
        "name": "model.generate",
        "reason": "用户点击生成后，逐次审阅并确认本次发送给所选模型的完整目标与资料。"
      }
    ],
    "optional": []
  }
}
